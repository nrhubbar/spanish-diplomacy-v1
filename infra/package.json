{
  "name": "spanish-diplomacy-infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AWS CDK app that hosts Spanish Diplomacy at spanish-diplomacy.nicholas-hubbard.com",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "synth": "cdk synth --strict --quiet",
    "diff": "cdk diff --all",
    "deploy": "cdk deploy --all --require-approval never --method direct --outputs-file cdk-outputs.json",
    "publish-site": "./scripts/publish-site.sh"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "aws-cdk": "2.1149.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "aws-cdk-lib": "2.277.0",
    "constructs": "10.8.1"
  }
}
