{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "specVersion": {
      "type": "number",
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "viewBox": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false,
      "description": "Coordinate space for geometry, anchors, and labels."
    },
    "focus": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false,
      "description": "Area framed by the camera when a game starts."
    },
    "background": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "description": "Fill for space outside the terrain layers; relief layers fade into it at their edges."
    },
    "geometry": {
      "type": "object",
      "properties": {
        "svg": {
          "type": "string",
          "pattern": "^[\\w./-]+\\.(svg|png|jpg|webp)$",
          "description": "Repository-relative path to a local asset. Runtime map services are not allowed."
        },
        "stripSelectors": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "svg"
      ],
      "additionalProperties": false
    },
    "terrain": {
      "description": "Optional relief, pre-registered to the view box. Without it the renderer draws flat region fills.",
      "type": "object",
      "properties": {
        "layers": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "image": {
                "type": "string",
                "pattern": "^[\\w./-]+\\.(svg|png|jpg|webp)$",
                "description": "Baked relief image with square texels."
              },
              "bounds": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "additionalProperties": false,
                "description": "Area the image covers, in view box units."
              }
            },
            "required": [
              "image",
              "bounds"
            ],
            "additionalProperties": false
          },
          "description": "Relief images, coarsest first; later layers draw over earlier ones."
        }
      },
      "required": [
        "layers"
      ],
      "additionalProperties": false
    },
    "regions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "territoryId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "territoryId"
        ],
        "additionalProperties": false
      },
      "description": "SVG element id to territory id. Several regions may share one territory."
    },
    "territories": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "unitAnchor": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          },
          "label": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "tier": {
                "type": "string",
                "enum": [
                  "overview",
                  "detail"
                ]
              }
            },
            "required": [
              "x",
              "y",
              "tier"
            ],
            "additionalProperties": false
          },
          "shape": {
            "description": "Drawn and hit-tested when the territory has no SVG region.",
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "circle"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "r": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "kind",
              "x",
              "y",
              "r"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "unitAnchor",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "cities": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "tier": {
            "type": "string",
            "enum": [
              "overview",
              "detail"
            ]
          }
        },
        "required": [
          "x",
          "y",
          "tier"
        ],
        "additionalProperties": false
      }
    },
    "contextLabels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "required": [
          "text",
          "x",
          "y"
        ],
        "additionalProperties": false
      }
    },
    "rivers": {
      "default": [],
      "description": "Rivers: scenery drawn above the territory wash and below the borders. No rules effect.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "rank": {
            "type": "string",
            "enum": [
              "main",
              "tributary"
            ],
            "description": "main: drawn at every zoom and labelled; tributary: drawn from the operational zoom."
          },
          "path": {
            "type": "string",
            "pattern": "^(?:M-?(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?: |(?=-))-?(?:\\d+(?:\\.\\d+)?|\\.\\d+)l-?(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?: |(?=-))-?(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?:(?: |(?=-))-?(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?: |(?=-))-?(?:\\d+(?:\\.\\d+)?|\\.\\d+))*)+$",
            "description": "The river's course on playable land, downstream."
          },
          "mouth": {
            "description": "The final stretch into the sea, drawn tapering.",
            "type": "string",
            "pattern": "^(?:M-?(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?: |(?=-))-?(?:\\d+(?:\\.\\d+)?|\\.\\d+)l-?(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?: |(?=-))-?(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?:(?: |(?=-))-?(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?: |(?=-))-?(?:\\d+(?:\\.\\d+)?|\\.\\d+))*)+$"
          },
          "labelPath": {
            "description": "Curve the name follows, west to east, from the operational zoom.",
            "type": "string",
            "pattern": "^(?:M-?(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?: |(?=-))-?(?:\\d+(?:\\.\\d+)?|\\.\\d+)l-?(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?: |(?=-))-?(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?:(?: |(?=-))-?(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?: |(?=-))-?(?:\\d+(?:\\.\\d+)?|\\.\\d+))*)+$"
          }
        },
        "required": [
          "id",
          "name",
          "rank",
          "path"
        ],
        "additionalProperties": false
      }
    },
    "waterLabels": {
      "default": [],
      "description": "Names of seas, gulfs, and bays: straight at a point, or along a curve.",
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "tier": {
                "type": "string",
                "enum": [
                  "overview",
                  "operational",
                  "detail"
                ],
                "description": "overview: always shown; operational: from the operational zoom; detail: from the detail zoom."
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "text",
              "tier",
              "x",
              "y"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "tier": {
                "type": "string",
                "enum": [
                  "overview",
                  "operational",
                  "detail"
                ],
                "description": "overview: always shown; operational: from the operational zoom; detail: from the detail zoom."
              },
              "paths": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(?:M-?(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?: |(?=-))-?(?:\\d+(?:\\.\\d+)?|\\.\\d+)l-?(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?: |(?=-))-?(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?:(?: |(?=-))-?(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?: |(?=-))-?(?:\\d+(?:\\.\\d+)?|\\.\\d+))*)+$"
                },
                "description": "Curves the name may follow, in order of preference; the first that fits on screen is used."
              }
            },
            "required": [
              "text",
              "tier",
              "paths"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "unitSymbols": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[\\w./-]+\\.(svg|png|jpg|webp)$",
        "description": "Repository-relative path to a local asset. Runtime map services are not allowed."
      },
      "description": "Unit type id to symbol SVG."
    },
    "attribution": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "specVersion",
    "id",
    "viewBox",
    "focus",
    "background",
    "geometry",
    "regions",
    "territories",
    "cities",
    "contextLabels",
    "unitSymbols",
    "attribution"
  ],
  "additionalProperties": false,
  "title": "Spanish Diplomacy map package",
  "description": "Presentation data interpreted by the map renderer."
}
