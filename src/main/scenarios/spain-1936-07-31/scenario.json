  "factions": [
    {
      "id": "republic",
      "name": "Republican Government",
      "abbreviation": "REP",
      "color": "#b1493f",
      "motivation": "Defend Madrid, Barcelona, Valencia, and the loyal northern cities.",
      "defaultActor": "local-human",
      "objectiveTerritoryIds": [
        "madrid",
        "catalunya",
        "valencia",
        "pais-vasco"
      ],
      "briefing": {
        "objective": "Hold the Republic together. You keep Madrid, Barcelona, Valencia, and the northern coast, but the rising has split the country in two. Win by holding 10 of 18 territories or 19 of 25 cities.",
        "firstTurnHint": "Reports from Toledo say columns are moving north out of Andaluc\u00eda, and the northern command is gathering beyond the Sierra de Guadarrama. Madrid has two regiments, its guards, and the militia columns holding the passes. Do we keep them all in the capital, or send some forward to meet the southern columns before they arrive?"
      }
    },
    {
      "id": "north",
      "name": "Northern Insurgent Command",
      "abbreviation": "NIC",
      "color": "#b39232",
      "motivation": "Drive toward Madrid and connect the northern insurgent zone.",
      "defaultActor": "computer",
      "objectiveTerritoryIds": [
        "madrid",
        "asturias",
        "pais-vasco",
        "aragon"
      ],
      "briefing": {
        "objective": "Link the insurgent zone and take Madrid. You hold Castilla y Le\u00f3n, Navarra, Galicia, and Zaragoza, and your garrison in Oviedo is besieged; the Basque coast and Santander sit behind your lines.",
        "firstTurnHint": "Zaragoza's garrison reports militia columns leaving Barcelona for Arag\u00f3n, and in Asturias the miners have Oviedo surrounded. Do we hold Arag\u00f3n and relieve Oviedo, or send the requet\u00e9s and the Sierra columns south toward Madrid while the Republic is still organizing?"
      }
    },
    {
      "id": "south",
      "name": "Southern Insurgent Command",
      "abbreviation": "SIC",
      "color": "#665089",
      "motivation": "Expand from Sevilla and the African bridgeheads toward Madrid.",
      "defaultActor": "computer",
      "objectiveTerritoryIds": [
        "extremadura",
        "madrid",
        "castilla-la-mancha",
        "andalucia"
      ],
      "briefing": {
        "objective": "Bring the Army of Africa across the Strait and march on Madrid. You hold Sevilla, C\u00f3rdoba, C\u00e1diz, and Granada, and the first of the Army of Africa has landed at Sevilla; most of the Legion and the Regulares still wait in Ceuta and Melilla.",
        "firstTurnHint": "The vanguard flown into Sevilla is ready to march, but most of the Legion and the Regulares are still in Africa, and every day they stay there gives the Republic time to organize. Do we bring them across now, or push north with the vanguard and the regiments in Andaluc\u00eda and let Africa follow?"
      }
    }
  ],
