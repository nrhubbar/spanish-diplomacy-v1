{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "specVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Stable kebab-case identifier. Never shown to players."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "snapshotLabel": {
      "type": "string",
      "minLength": 1,
      "description": "Starting date or moment, shown on setup and turn 1."
    },
    "ruleset": {
      "type": "string",
      "const": "m2-movement",
      "description": "Rules the engine applies. Unknown rulesets fail to load."
    },
    "map": {
      "type": "string",
      "minLength": 1,
      "description": "Path to the map package, relative to this file."
    },
    "victory": {
      "type": "object",
      "properties": {
        "territoryShare": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "cityShare": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "tieBreak": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "cities",
              "territories"
            ]
          },
          "description": "Order in which qualifying factions are compared. A remaining tie is a shared victory."
        }
      },
      "required": [
        "territoryShare",
        "cityShare",
        "tieBreak"
      ],
      "additionalProperties": false
    },
    "unitTypes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable kebab-case identifier. Never shown to players."
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "factions": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable kebab-case identifier. Never shown to players."
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "abbreviation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "motivation": {
            "type": "string",
            "minLength": 1
          },
          "defaultActor": {
            "type": "string",
            "enum": [
              "local-human",
              "computer"
            ]
          },
          "objectiveTerritoryIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Stable kebab-case identifier. Never shown to players."
            }
          }
        },
        "required": [
          "id",
          "name",
          "abbreviation",
          "color",
          "motivation",
          "defaultActor",
          "objectiveTerritoryIds"
        ],
        "additionalProperties": false
      }
    },
    "territories": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable kebab-case identifier. Never shown to players."
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "countsForVictory": {
            "type": "boolean"
          },
          "initialControl": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "controlled"
                  },
                  "factionId": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                    "description": "Stable kebab-case identifier. Never shown to players."
                  }
                },
                "required": [
                  "kind",
                  "factionId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "contested"
                  },
                  "factionIds": {
                    "minItems": 2,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                      "description": "Stable kebab-case identifier. Never shown to players."
                    },
                    "description": "Factions with a meaningful presence. At least two."
                  }
                },
                "required": [
                  "kind",
                  "factionIds"
                ],
                "additionalProperties": false
              }
            ]
          },
          "isolated": {
            "description": "Required when a territory deliberately has no connections.",
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "countsForVictory",
          "initialControl"
        ],
        "additionalProperties": false
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "between": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "description": "Stable kebab-case identifier. Never shown to players."
              },
              {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "description": "Stable kebab-case identifier. Never shown to players."
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "kind": {
            "type": "string",
            "enum": [
              "land",
              "sea"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "between",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "cities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable kebab-case identifier. Never shown to players."
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "territoryId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable kebab-case identifier. Never shown to players."
          },
          "countsForVictory": {
            "type": "boolean"
          },
          "initialController": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable kebab-case identifier. Never shown to players."
          }
        },
        "required": [
          "id",
          "name",
          "territoryId",
          "countsForVictory"
        ],
        "additionalProperties": false
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable kebab-case identifier. Never shown to players."
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "factionId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable kebab-case identifier. Never shown to players."
          },
          "type": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable kebab-case identifier. Never shown to players."
          },
          "formationKind": {
            "type": "string",
            "enum": [
              "regiment",
              "battalion",
              "column",
              "security",
              "other"
            ]
          },
          "approximateStrength": {
            "description": "Display-only. Has no rules effect under m2-movement.",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "territoryId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable kebab-case identifier. Never shown to players."
          },
          "cityId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable kebab-case identifier. Never shown to players."
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceId": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                  "description": "Stable kebab-case identifier. Never shown to players."
                },
                "reference": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "sourceId"
              ],
              "additionalProperties": false
            }
          },
          "historicalNote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "factionId",
          "type",
          "formationKind",
          "territoryId",
          "sources"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable kebab-case identifier. Never shown to players."
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "specVersion",
    "id",
    "name",
    "snapshotLabel",
    "ruleset",
    "map",
    "victory",
    "unitTypes",
    "factions",
    "territories",
    "connections",
    "cities",
    "units",
    "sources"
  ],
  "additionalProperties": false,
  "title": "Spanish Diplomacy scenario package",
  "description": "Rules data interpreted by the game engine."
}
