{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "specVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Stable kebab-case identifier. Never shown to players."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "snapshotLabel": {
      "type": "string",
      "minLength": 1,
      "description": "Starting date or moment, shown on setup and turn 1."
    },
    "ruleset": {
      "type": "string",
      "const": "m2-strength",
      "description": "Rules the engine applies. Unknown rulesets fail to load."
    },
    "map": {
      "type": "string",
      "minLength": 1,
      "description": "Path to the map package, relative to this file."
    },
    "victory": {
      "type": "object",
      "properties": {
        "territoryShare": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "cityShare": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "tieBreak": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "cities",
              "territories"
            ]
          },
          "description": "Order in which qualifying factions are compared. A remaining tie is a shared victory."
        }
      },
      "required": [
        "territoryShare",
        "cityShare",
        "tieBreak"
      ],
      "additionalProperties": false
    },
    "combat": {
      "type": "object",
      "properties": {
        "table": {
          "minItems": 7,
          "maxItems": 7,
          "type": "array",
          "items": {
            "minItems": 7,
            "maxItems": 7,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "attacker-eliminated",
                "attacker-attrition",
                "attacker-demoralized",
                "both-demoralized",
                "defender-demoralized",
                "defender-exchange",
                "defender-eliminated"
              ]
            },
            "description": "Results for modified rolls 0 to 6."
          },
          "description": "Seven odds columns: below 1:1, then 1:1 to 6:1. Each lists the result for modified rolls 0 to 6."
        },
        "belowOneToOne": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "halving"
            },
            "rollPenalty": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "rollPenalty"
          ],
          "additionalProperties": false,
          "description": "Below 1:1 the attacker's roll takes rollPenalty for each halving of the odds."
        },
        "diggingIn": {
          "type": "object",
          "properties": {
            "perTurn": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "max": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "perTurn",
            "max"
          ],
          "additionalProperties": false,
          "description": "Defence roll bonus gained per quiet turn, up to max."
        },
        "demoralizationFactor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "Multiplier applied to a demoralized army's attack and defence."
        },
        "factionModifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "description": "Stable kebab-case identifier. Never shown to players."
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Player-facing name shown in battle breakdowns."
              },
              "factionId": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "description": "Stable kebab-case identifier. Never shown to players."
              },
              "when": {
                "type": "string",
                "enum": [
                  "holds-controlled-city"
                ],
                "description": "holds-controlled-city: the battle territory has a city the faction controlled at the start of the turn."
              },
              "attack": {
                "description": "Roll bonus when the faction attacks. Defaults to 0.",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "defence": {
                "description": "Roll bonus when the faction defends. Defaults to 0.",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "name",
              "factionId",
              "when"
            ],
            "additionalProperties": false
          },
          "description": "Named roll modifiers for particular factions."
        }
      },
      "required": [
        "table",
        "belowOneToOne",
        "diggingIn",
        "demoralizationFactor",
        "factionModifiers"
      ],
      "additionalProperties": false,
      "description": "Tunable numbers of the m2-strength battle rules."
    },
    "unitTypes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable kebab-case identifier. Never shown to players."
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "attack": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "Attack value of a full-strength army of this type."
          },
          "defence": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "Defence value of a full-strength army of this type."
          }
        },
        "required": [
          "id",
          "name",
          "attack",
          "defence"
        ],
        "additionalProperties": false
      }
    },
    "factions": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable kebab-case identifier. Never shown to players."
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "abbreviation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "motivation": {
            "type": "string",
            "minLength": 1
          },
          "defaultActor": {
            "type": "string",
            "enum": [
              "local-human",
              "computer"
            ]
          },
          "objectiveTerritoryIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Stable kebab-case identifier. Never shown to players."
            }
          },
          "briefing": {
            "type": "object",
            "properties": {
              "objective": {
                "type": "string",
                "minLength": 1,
                "description": "What the faction is fighting for and how it wins. Shown in the Briefing."
              },
              "firstTurnHint": {
                "type": "string",
                "minLength": 1,
                "description": "Turn 1 intelligence report that ends in a choice, never a move to copy. Shown in the Briefing on turn 1."
              }
            },
            "required": [
              "objective",
              "firstTurnHint"
            ],
            "additionalProperties": false,
            "description": "Player-facing briefing text for this faction."
          }
        },
        "required": [
          "id",
          "name",
          "abbreviation",
          "color",
          "motivation",
          "defaultActor",
          "objectiveTerritoryIds",
          "briefing"
        ],
        "additionalProperties": false
      }
    },
    "territories": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable kebab-case identifier. Never shown to players."
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "countsForVictory": {
            "type": "boolean"
          },
          "initialControl": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "controlled"
                  },
                  "factionId": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                    "description": "Stable kebab-case identifier. Never shown to players."
                  }
                },
                "required": [
                  "kind",
                  "factionId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "contested"
                  },
                  "factionIds": {
                    "minItems": 2,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                      "description": "Stable kebab-case identifier. Never shown to players."
                    },
                    "description": "Factions with a meaningful presence. At least two."
                  }
                },
                "required": [
                  "kind",
                  "factionIds"
                ],
                "additionalProperties": false
              }
            ]
          },
          "isolated": {
            "description": "Required when a territory deliberately has no connections.",
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "countsForVictory",
          "initialControl"
        ],
        "additionalProperties": false
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "between": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "description": "Stable kebab-case identifier. Never shown to players."
              },
              {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "description": "Stable kebab-case identifier. Never shown to players."
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "kind": {
            "type": "string",
            "enum": [
              "land",
              "sea"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "between",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "cities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable kebab-case identifier. Never shown to players."
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "territoryId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable kebab-case identifier. Never shown to players."
          },
          "countsForVictory": {
            "type": "boolean"
          },
          "initialController": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable kebab-case identifier. Never shown to players."
          }
        },
        "required": [
          "id",
          "name",
          "territoryId",
          "countsForVictory"
        ],
        "additionalProperties": false
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable kebab-case identifier. Never shown to players."
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "designation": {
            "description": "Short counter label, up to 4 capitals or digits. Derived from the name when absent.",
            "type": "string",
            "pattern": "^[A-Z0-9]{1,4}$"
          },
          "factionId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable kebab-case identifier. Never shown to players."
          },
          "type": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable kebab-case identifier. Never shown to players."
          },
          "formationKind": {
            "type": "string",
            "enum": [
              "regiment",
              "battalion",
              "column",
              "security",
              "other"
            ]
          },
          "strength": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "Men at the scenario snapshot. At most fullStrength."
          },
          "fullStrength": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "Men at full establishment; the type's values apply at this strength."
          },
          "territoryId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable kebab-case identifier. Never shown to players."
          },
          "cityId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable kebab-case identifier. Never shown to players."
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceId": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                  "description": "Stable kebab-case identifier. Never shown to players."
                },
                "reference": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "sourceId"
              ],
              "additionalProperties": false
            }
          },
          "historicalNote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "factionId",
          "type",
          "formationKind",
          "strength",
          "fullStrength",
          "territoryId",
          "sources"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable kebab-case identifier. Never shown to players."
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "specVersion",
    "id",
    "name",
    "snapshotLabel",
    "ruleset",
    "map",
    "victory",
    "combat",
    "unitTypes",
    "factions",
    "territories",
    "connections",
    "cities",
    "units",
    "sources"
  ],
  "additionalProperties": false,
  "title": "Spanish Diplomacy scenario package",
  "description": "Rules data interpreted by the game engine."
}
